{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMEISE local adviser advice v2",
  "description": "Evidence-linked advice for manual simulator use. Recommendations name policy entries with structured arguments; this format cannot execute commands. The local server additionally validates policy arguments, evidence and current revision.",
  "type": "object",
  "required": [
    "api_version",
    "advice_id",
    "stream_id",
    "based_on_revision",
    "policy_version",
    "source",
    "summary",
    "observations",
    "recommendations",
    "missing_information"
  ],
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "2"
    },
    "advice_id": {
      "$ref": "#/$defs/id"
    },
    "stream_id": {
      "$ref": "#/$defs/id"
    },
    "based_on_revision": {
      "type": "integer",
      "minimum": 1
    },
    "policy_version": {
      "const": "qa200-1.95-v1"
    },
    "source": {
      "enum": [
        "agent",
        "demo"
      ]
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "observations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "missing_information": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/text"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "text",
        "evidence_event_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "evidence_event_ids": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": [
        "command_id",
        "arguments",
        "reason",
        "evidence_event_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "$ref": "#/$defs/id"
        },
        "arguments": {
          "type": "object",
          "maxProperties": 16
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "evidence_event_ids": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  }
}
